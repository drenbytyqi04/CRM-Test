# Kopjo këtë skedë si `.env.local` dhe plotëso vlerat nga Supabase:
# Dashboard -> projekti yt -> Settings -> API

# "Project URL"
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# "service_role" secret — KURRË mos e ndaj publikisht dhe kurrë mos e vendos
# në kod. Skeda `.env.local` nuk ruhet në git (shih .gitignore).
SUPABASE_SERVICE_ROLE_KEY=eyJ...
