# Kopjo këtë skedë si `.env.local` dhe plotëso VETËM çelësin poshtë.
#
#   cp .env.local.example .env.local
#
# Adresa e projektit është e mbushur tashmë — projekti "crm-test" u krijua
# në llogarinë tënde të Supabase-it dhe tabelat janë gati.

SUPABASE_URL=https://zfdavzndfhsjckvifxur.supabase.co

# Çelësi sekret `service_role`:
# supabase.com/dashboard -> projekti "crm-test" -> Settings -> API ->
# te "Project API keys" kliko "Reveal" mbi `service_role` dhe kopjoje këtu.
#
# ⚠️ Mos ia jep askujt dhe mos e vendos në asnjë skedë tjetër.
# `.env.local` nuk ruhet në git, prandaj nuk përfundon kurrë në GitHub.
SUPABASE_SERVICE_ROLE_KEY=
